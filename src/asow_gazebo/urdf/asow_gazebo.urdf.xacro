<?xml version="1.0"?>
<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="ASOW">

  <!--
    Canonical final HW description.
    Geometry / inertia / revolute joint definition의 Source of Truth는
    asow_hw_description/urdf/asow_robot.urdf 이다.
  -->
  <xacro:include
    filename="$(find asow_hw_description)/urdf/asow_robot.urdf"/>

  <!--
    Gazebo simulation에서 중앙 몸체를 world에 고정.
    기존 simulation baseline의 높이 0.15 m 유지.
  -->
  <link name="world"/>

  <joint name="world_fixed_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!--
    Gazebo용 ros2_control joint interface.
    Joint 이름과 position limit은 canonical final HW URDF와 일치해야 한다.
  -->
  <xacro:macro
    name="gazebo_control_joint"
    params="joint_name lower upper">

    <joint name="${joint_name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>
    </joint>

  </xacro:macro>

  <ros2_control
    name="GazeboSimSystem"
    type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Left arm -->

    <xacro:gazebo_control_joint
      joint_name="left_joint1"
      lower="-0.523599"
      upper="1.570796"/>

    <xacro:gazebo_control_joint
      joint_name="left_joint2"
      lower="-1.570796"
      upper="1.570796"/>

    <xacro:gazebo_control_joint
      joint_name="left_joint3"
      lower="-1.570796"
      upper="1.570796"/>

    <xacro:gazebo_control_joint
      joint_name="left_joint4"
      lower="-1.570796"
      upper="1.570796"/>

    <xacro:gazebo_control_joint
      joint_name="left_joint5"
      lower="-1.570796"
      upper="1.570796"/>

    <!-- Right arm -->

    <xacro:gazebo_control_joint
      joint_name="right_joint1"
      lower="-1.570796"
      upper="0.523599"/>

    <xacro:gazebo_control_joint
      joint_name="right_joint2"
      lower="-1.570796"
      upper="1.570796"/>

    <xacro:gazebo_control_joint
      joint_name="right_joint3"
      lower="-1.570796"
      upper="1.570796"/>

    <xacro:gazebo_control_joint
      joint_name="right_joint4"
      lower="-1.570796"
      upper="1.570796"/>

    <xacro:gazebo_control_joint
      joint_name="right_joint5"
      lower="-1.570796"
      upper="1.570796"/>

  </ros2_control>

  <!--
    Gazebo 내부에 ros2_control controller_manager를 생성.
    Controller configuration은 asow_gazebo/config/ros2_controllers.yaml.
  -->
  <gazebo>
    <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <robot_param>
        robot_description
      </robot_param>

      <robot_param_node>
        robot_state_publisher
      </robot_param_node>

      <parameters>
        $(find asow_gazebo)/config/ros2_controllers.yaml
      </parameters>

      <controller_manager_name>
        controller_manager
      </controller_manager_name>

    </plugin>
  </gazebo>

</robot>
